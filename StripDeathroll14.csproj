<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Description>Hosts Strip Deathroll at a venue. Choose Private (say) or Public (party/alliance), build the player list from your party or by name, and it reads everyone's /random or /dice from chat: the highest opening roll starts round 1, later rounds resume with the player after the winner, the turn goes down your list, each player is called to roll the previous number, a 0, 1, 69 or 666 wins the round, and the winner picks who loses which piece (top, bottom or shoes). It alerts on a wrong number (and calls the player once to reroll) or an out-of-turn roll, keeps every roll of every round and every game (Game 1, Game 2...) with a running tally and CSV export, lets you fix or add a missed roll in the round in play, can remind a player who has not rolled (once in chat with a toast for you, then every 10 seconds in your Echo, rippling their circle), has a debug mode with dummy players, and posts your rules and ad texts. Lines are posted only when you press Post unless you turn on auto-post (for the kinds of line you choose) or reminders, one at a time, a random 2 to 4 seconds apart by default, within limits you pick.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="StripDeathroll14.Tests/**" />
    <!-- KosLib submodule: compile its sources only, never its tests or nested obj/ -->
    <Compile Remove="KosLib/**" />
    <Compile Include="KosLib/src/**/*.cs" />
    <!-- KosDraw submodule (world markers): sources only. Dalamud ships TerraFX but the SDK does not reference it;
         Private=false keeps Dalamud's copy the one loaded and out of the release zip. -->
    <Compile Remove="KosDraw/**" />
    <Compile Include="KosDraw/src/**/*.cs" />
    <Reference Include="TerraFX.Interop.Windows" Private="false" />
  </ItemGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>StripDeathroll14</Name>
    <Punchline>Strip Deathroll host helper: turn order, roll calls, wrong-roll alerts, lives and round history.</Punchline>
    <RepoUrl>https://github.com/priestkos/StripDeathroll14</RepoUrl>
    <Tags>deathroll;minigame;random;venue;utility</Tags>
    <IconUrl>https://raw.githubusercontent.com/priestkos/StripDeathroll14/main/images/icon.png</IconUrl>
  </PropertyGroup>
</Project>
